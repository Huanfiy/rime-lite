FRAG_END = "的了着吗呢吧啊么呀下说"


# ---------- 解析 ----------

def parse_userdb(path):
    """解析 userdb 导出文本（拼音<Tab>词<Tab>c=.. d=.. t=..）。

    返回 (entries, raw, dropped)：entries 为 list[(word, pinyin, c)]，
    raw 为非空行数（含注释头），dropped 为 c<=0 丢弃数。
    """
    entries = []
    raw = 0
    dropped = 0
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line:
                continue
            raw += 1
            if line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) < 3:
                continue
            pinyin = parts[0].strip()
            word = parts[1].strip()
            m = C_RE.search(parts[2])
            if not m:
                continue
            c = int(m.group(1))
            if c <= 0:
                dropped += 1
                continue
            entries.append((word, pinyin, c))
    return entries, raw, dropped


def parse_dict_yaml(path):
    """dict.yaml：跳过 `...` 之前的 YAML 头，逐行产出 (行号, 词, 拼音, 权重)。

    拼音或权重列缺失时分别为 "" / 0。
    """
    in_body = False
    with open(path, encoding="utf-8") as f:
        for lineno, line in enumerate(f, 1):
            line = line.rstrip("\n")
            if not in_body:
                if line.strip() == "...":
                    in_body = True
                continue
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = line.split("\t")
            code = parts[1].strip() if len(parts) > 1 else ""
            try:
                weight = float(parts[2]) if len(parts) > 2 and parts[2].strip() else 0.0
            except ValueError:
                weight = 0.0
            yield lineno, parts[0].strip(), code, weight


def parse_dict_yaml_words(path):
    return {word for _, word, _, _ in parse_dict_yaml(path)}


def parse_tabledb_words(path):
    words = set()
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip() or line.startswith("#"):
                continue
            words.add(line.split("\t")[0].strip())
    return words


def load_exclude_words(repo_root):
    """从仓库 rime/ 读取词级排除集；缺文件即报错退出（排除集不完整会产出错误候选）。"""
    words = set()
    for rel in EXCLUDE_DICT_YAMLS:
        path = os.path.join(repo_root, rel)
        if not os.path.isfile(path):
            sys.exit(f"错误: 排除集文件不存在: {path}")
        words |= parse_dict_yaml_words(path)
    for rel in EXCLUDE_TABLEDB:
        path = os.path.join(repo_root, rel)
        if not os.path.isfile(path):
            sys.exit(f"错误: 排除集文件不存在: {path}")
        words |= parse_tabledb_words(path)
    return words


def load_vendor_codes(repo_root):
    """vendor 层同码表：拼音 → {词: 最高权重}。"""
    by_code = defaultdict(dict)
    for rel in VENDOR_DICT_YAMLS:
        path = os.path.join(repo_root, rel)
        if not os.path.isfile(path):
            sys.exit(f"错误: vendor 词库不存在: {path}")
        for _, word, code, weight in parse_dict_yaml(path):
            same = by_code[code]
            same[word] = max(same.get(word, 0.0), weight)
    return by_code


# ---------- 权重规则（D-32） ----------

def rivals_of(word, code, vendor_codes):
    """同码 vendor 竞争词（排除同词），按权重降序的 [(词, 权重)]。"""
    same = vendor_codes.get(code, {})
    return sorted(((w, x) for w, x in same.items() if w != word),
                  key=lambda r: (-r[1], r[0]))


def suggest_weight(rivals):
    """规则建议权重：落在同码第 2 位、不抢第 1；不足 2 个竞争词时为 BASE_WEIGHT。"""
    if len(rivals) < 2:
        return BASE_WEIGHT
    return max(BASE_WEIGHT, int(rivals[1][1]) + 1)


def fmt_weight(x):
    return str(int(x)) if float(x).is_integer() else str(x)


def fmt_rivals(rivals):
    return " ".join(f"{w}:{fmt_weight(x)}" for w, x in rivals[:N_RIVALS_SHOWN])


# ---------- 判定 ----------

def is_cjk(ch):
    cp = ord(ch)
    return (
        0x4E00 <= cp <= 0x9FFF
        or 0x3400 <= cp <= 0x4DBF
        or 0xF900 <= cp <= 0xFAFF
        or 0x20000 <= cp <= 0x3134F
    )


def is_ascii_word(word):
    return bool(word) and all(ord(ch) < 128 for ch in word)


def bucket_of(word):
    if is_ascii_word(word) and LATIN_DIGIT_RE.search(word):
        return "en_priority"
    if LATIN_DIGIT_RE.search(word):
        return "custom_phrase"
    for kw in EMBEDDED_KEYWORDS:
        if kw in word:
            return "embedded"
    return "mydict"


def flag_of(word):
    if len(word) >= 4:
        for s in FRAG_SUBSTR:
            if s in word:
                return "fragment?"
    if len(word) >= 3 and (word[0] in FRAG_START or word[-1] in FRAG_END):
        return "fragment?"
    return ""


def source_label(path):
    """来源列名：文件名去掉 .userdb.txt / .txt 后缀。"""
    name = os.path.basename(path)
    for suffix in (".userdb.txt", ".txt"):
        if name.endswith(suffix):
            return name[: -len(suffix)]
    return name


# ---------- 自建层权重核查 ----------

def audit(args):
    """列出 embedded / mydict 中改用规则建议值后同码位次会提前的行。

    有效权重 = 同词同码在各层的最高权重；位次只对 vendor 竞争词计算。
    无竞争词时权重不影响位次，不列出。
    """
    vendor_codes = load_vendor_codes(args.repo_root)
    own = []  # (位置, 词, 拼音, 权重)
    for rel in OWN_DICT_YAMLS:
        path = os.path.join(args.repo_root, rel)
        if not os.path.isfile(path):
            sys.exit(f"错误: 词库不存在: {path}")
        for lineno, word, code, weight in parse_dict_yaml(path):
            own.append((f"{os.path.basename(rel)}:{lineno}", word, code, weight))
    own_max = defaultdict(float)
    for _, word, code, weight in own:
        own_max[(word, code)] = max(own_max[(word, code)], weight)

    n_rivaled = 0
    rows = []  # (位置, 词, 拼音, 权重, 现位次, 建议权重, 竞争词)
    for where, word, code, weight in own:
        rivals = rivals_of(word, code, vendor_codes)
        if rivals:
            n_rivaled += 1
        target = suggest_weight(rivals)
        effective = max(own_max[(word, code)],
                        vendor_codes.get(code, {}).get(word, 0.0))
        rank = 1 + sum(1 for _, x in rivals if x > effective)
        new_rank = 1 + sum(1 for _, x in rivals if x > target)
        if new_rank >= rank:
            continue
        rows.append((where, word, code, fmt_weight(weight), rank, target,
                     new_rank, fmt_rivals(rivals)))
    rows.sort(key=lambda r: (-r[4], r[0]))

    header = ["where", "word", "pinyin", "weight", "rank", "suggested",
              "new_rank", "rivals"]
    out = open(args.output, "w", encoding="utf-8") if args.output else sys.stdout
    try:
        out.write("\t".join(header) + "\n")
        for row in rows:
            out.write("\t".join(str(x) for x in row) + "\n")
    finally:
        if args.output:
            out.close()

    err = sys.stderr
    err.write("自建层权重核查（D-32）\n")
    err.write("=" * 44 + "\n")
    err.write(f"自建词条数: {len(own)}\n")
    err.write(f"有同码 vendor 竞争词: {n_rivaled}\n")
    err.write(f"按建议值可提前位次: {len(rows)}"
              f"（现位次 >= 6: {sum(1 for r in rows if r[4] >= 6)}）\n")


# ---------- 主流程 ----------

def main():
    ap = argparse.ArgumentParser(
        prog="userdb-candidates",
        description="Rime userdb 晋升候选分析（只读）：从 userdb 导出文本机械筛选"
                    "晋升候选，bucket/flag 仅为启发式建议，人工审定后再入库。",
    )
    ap.add_argument("userdb", nargs="*", metavar="userdb导出.txt",
                    help="userdb 导出文本路径（拼音<Tab>词<Tab>c=.. d=.. t=..），可多份")
    ap.add_argument("--audit", action="store_true",
                    help="改为核查 embedded / mydict 现有词条的权重（不读 userdb 导出）")
    ap.add_argument("-o", "--output", metavar="FILE",
                    help="候选 TSV 输出文件（默认打印到 stdout）")
    ap.add_argument("--min-count", type=int, default=3, metavar="N",
                    help="合并计数 c_total 阈值，低于该值过滤（默认 3）")
    ap.add_argument("--repo-root", default=DEFAULT_REPO_ROOT, metavar="DIR",
                    help="仓库根目录，排除集从 <DIR>/rime/ 读取"
                         "（默认相对本脚本定位；用于历史复现或仓库副本）")
    args = ap.parse_args()

    if args.audit:
        if args.userdb:
            ap.error("--audit 不读 userdb 导出，请去掉导出文件参数")
        audit(args)
        return
    if not args.userdb:
        ap.error("缺少 userdb 导出文件（或使用 --audit）")
    if args.min_count < 1:
        ap.error("--min-count 必须 >= 1")

    # 逐份解析导出
    labels = [source_label(p) for p in args.userdb]
    if len(set(labels)) != len(labels):
        labels = [f"{lb}#{i + 1}" for i, lb in enumerate(labels)]
    per_source = []  # (label, entries, raw, dropped)
    for path, label in zip(args.userdb, labels):
        if not os.path.isfile(path):
            sys.exit(f"错误: 导出文件不存在: {path}")
        entries, raw, dropped = parse_userdb(path)
        per_source.append((label, entries, raw, dropped))

    # 按 (词, 拼音) 合并，逐来源分列求和
    n_sources = len(per_source)
    merged = defaultdict(lambda: [0] * n_sources)
    for idx, (_, entries, _, _) in enumerate(per_source):
        for w, p, c in entries:
            merged[(w, p)][idx] += c

    exclude_words = load_exclude_words(args.repo_root)
    vendor_codes = load_vendor_codes(args.repo_root)

    # 漏斗筛选
    n_single_cjk = 0
    n_excluded = 0
    n_ascii_pinyin = 0
    n_threshold = 0
    candidates = []  # (word, pinyin, c_total, *c_per_source, weight, rivals, bucket, flag)
    for (w, p), cs in merged.items():
        if len(w) == 1 and is_cjk(w):
            n_single_cjk += 1
            continue
        if w in exclude_words:
            n_excluded += 1
            continue
        if w.isascii() and w == p.replace(" ", ""):
            n_ascii_pinyin += 1
            continue
        c_total = sum(cs)
        if c_total < args.min_count:
            n_threshold += 1
            continue
        rivals = rivals_of(w, p, vendor_codes)
        candidates.append((w, p, c_total, *cs, suggest_weight(rivals),
                           fmt_rivals(rivals), bucket_of(w), flag_of(w)))

    candidates.sort(key=lambda x: (-x[2], x[0]))

    # 候选 TSV → stdout 或 --output
    header = ["word", "pinyin", "c_total"] + [f"c_{lb}" for lb in labels] \
        + ["weight", "rivals", "bucket", "flag"]
    out = open(args.output, "w", encoding="utf-8") if args.output else sys.stdout
    try:
        out.write("\t".join(header) + "\n")
        for row in candidates:
            out.write("\t".join(str(x) for x in row) + "\n")
    finally:
        if args.output:
            out.close()

    # 漏斗统计 → stderr
    bucket_counts = defaultdict(int)
    flag_counts = defaultdict(int)
    for row in candidates:
        bucket_counts[row[-2]] += 1
        if row[-1]:
            flag_counts[row[-1]] += 1

    err = sys.stderr
    err.write("userdb 晋升候选分析 — 漏斗统计\n")
    err.write("=" * 44 + "\n")
    for (label, entries, raw, dropped), path in zip(per_source, args.userdb):
        err.write(f"{path}\n")
        err.write(f"  非空行数(含注释): {raw}  c<=0 丢弃: {dropped}"
                  f"  有效条目: {len(entries)}\n")
    err.write(f"按 (词, 拼音) 合并后条目数: {len(merged)}\n")
    err.write(f"排除集词数(仓库根 {args.repo_root}): {len(exclude_words)}\n")
    err.write(f"单个 CJK 字符排除数: {n_single_cjk}\n")
    err.write(f"对照集词级排除数: {n_excluded}\n")
    err.write(f"纯 ASCII 与拼音相同排除数: {n_ascii_pinyin}\n")
    err.write(f"c_total < {args.min_count} 阈值过滤数: {n_threshold}\n")
    err.write(f"最终候选数: {len(candidates)}\n")
    err.write("各桶数量(启发式建议):\n")
    for b in ("en_priority", "custom_phrase", "embedded", "mydict"):
        err.write(f"  {b}: {bucket_counts.get(b, 0)}\n")
    err.write("flag 统计(启发式建议):\n")
    if flag_counts:
        for k in sorted(flag_counts):
            err.write(f"  {k}: {flag_counts[k]}\n")
    else:
        err.write("  (无)\n")

    # 数据质量提示：候选集内同词多拼音
    by_word = defaultdict(set)
    for row in candidates:
        by_word[row[0]].add(row[1])
    multi = {w: ps for w, ps in by_word.items() if len(ps) > 1}
    err.write(f"候选集内同词多拼音的词数: {len(multi)}\n")
    for w, ps in sorted(multi.items()):
        err.write(f"  {w}: {' | '.join(sorted(ps))}\n")


if __name__ == "__main__":
    main()
